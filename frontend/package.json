  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e:runner:list": "npx --yes --package=node@20 node ./node_modules/@playwright/test/cli.js test --config=playwright.config.js --list --reporter=line",
    "e2e:runner:auth": "npx --yes --package=node@20 node ./node_modules/@playwright/test/cli.js test tests/e2e/authorization.spec.js --config=playwright.config.js --project=chromium --workers=1 --reporter=line",
    "test:e2e:list": "npx --yes --package=node@20 node ./node_modules/@playwright/test/cli.js test --config=playwright.config.js --list --reporter=line",
    "test:e2e:auth": "npx --yes --package=node@20 node ./node_modules/@playwright/test/cli.js test tests/e2e/authorization.spec.js --config=playwright.config.js --project=chromium --workers=1 --reporter=line",
    "test:e2e:admin": "npx --yes --package=node@20 node ./node_modules/@playwright/test/cli.js test tests/e2e/admin-course-lifecycle.spec.js --config=playwright.config.js --project=chromium --workers=1 --reporter=line",
    "test:e2e:quiz": "npx --yes --package=node@20 node ./node_modules/@playwright/test/cli.js test tests/e2e/quiz-lifecycle.spec.js --config=playwright.config.js --project=chromium --workers=1 --reporter=line"
  },
