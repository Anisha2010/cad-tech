{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "^/(?:about|cad-models(?:/[^/]+)?|cad-services(?:/[^/]+)?|check-email|certificates/verify/[^/]+|contact|courses(?:/[^/]+)?|digital-item-policy|forgot-password|gallery|instructor(?:/.*)?|legal|login|model/[^/]+|privacy-policy|refund-policy|register|reset-password|services(?:/[^/]+)?|student(?:/.*)?|terms|verify-email|auth/callback|admin(?:/.*)?)/?$",
      "dest": "/index.html"
    },
    { "src": "^/$", "dest": "/index.html" },
    { "src": ".*", "status": 404, "dest": "/404.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
