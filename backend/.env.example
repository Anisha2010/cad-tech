NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PORT=5000
SESSION_SECRET=replace_with_a_long_random_secret
# Application database.
MONGODB_URI=mongodb://127.0.0.1:27017/cadtech
# Local in-memory mail preview; no provider credentials or real email delivery.
EMAIL_PROVIDER=mock
EMAIL_FROM=CadTech <no-reply@localhost>
# Optional SMTP configuration instead of the local mock:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=CadTech <no-reply@your-domain.example>
# Optional Resend configuration instead of the local mock:
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your_resend_api_key
# EMAIL_FROM=CadTech <noreply@your-verified-domain.com>
# Use a verified domain for real transactional email; the provider smoke test
# separately uses Resend's sandbox sender and recipient.
# Optional email-auth settings (bounded defaults are applied)
LOGIN_OTP_TTL_MINUTES=10
LOGIN_OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
# Production example (do not use real credentials here):
# MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/cadtech?retryWrites=true&w=majority

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Secure CAD uploads default to 50 MiB and are capped at Cloudinary's 100 MB single-upload limit.
CAD_FILE_UPLOAD_MAX_BYTES=52428800

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
