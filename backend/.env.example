NODE_ENV=development
FRONTEND_URL=http://localhost:5173
PORT=5000
SESSION_SECRET=replace_with_a_long_random_secret
MONGODB_URI=mongodb://127.0.0.1:27017/cadtech
# SMTP settings for email verification, OTP sign-in, and password reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_GMAIL@gmail.com
SMTP_PASSWORD=YOUR_16_CHARACTER_APP_PASSWORD
SMTP_FROM=YOUR_GMAIL@gmail.com
# Optional email-auth settings (bounded defaults are applied)
LOGIN_OTP_TTL_MINUTES=10
LOGIN_OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
# Production example (do not use real credentials here):
# MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/cadtech?retryWrites=true&w=majority

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
