{
  "name": "cadtech-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node --check server.js && find src scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "NODE_ENV=test node --test tests/*.test.js",
    "create:admin": "node scripts/createAdmin.js",
    "seed:courses": "node scripts/seedCourses.js",
    "migrate:courses": "node scripts/migrateStaticCourses.js",
    "migrate:users:check": "node scripts/migrateUsersFromJson.js",
    "migrate:users": "node scripts/migrateUsersFromJson.js --execute",
    "migrate:payments:check": "node scripts/migratePaymentsFromJson.js",
    "migrate:payments": "node scripts/migratePaymentsFromJson.js --execute",
    "migrate:cad-orders:check": "node scripts/migrateCadOrderReservations.js",
    "migrate:cad-orders": "node scripts/migrateCadOrderReservations.js --apply",
    "email:smoke": "node scripts/email-provider-smoke.js",
    "start:e2e": "npx --yes --package=node@20 node scripts/start-e2e.js",
    "seed:e2e": "npx --yes --package=node@20 node scripts/seed-e2e-users.js",
    "cleanup:e2e": "npx --yes --package=node@20 node scripts/cleanup-e2e-run.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.0",
    "cloudinary": "^2.11.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.5.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "openid-client": "^6.4.0",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
