# This is a top-level reference only. The applications read their own templates:
#   - Backend:  backend/.env.example  -> copy to backend/.env
#   - Frontend: frontend/.env.example -> copy to frontend/.env
# See DEPLOYMENT.md for production (Render/Vercel) environment variables.

FRONTEND_URL=http://localhost:5173

# Backend email delivery (mock is local-only, no real email is sent)
EMAIL_PROVIDER=mock
EMAIL_FROM=CadTech <no-reply@localhost>
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your_resend_api_key

# Optional auth email controls (defaults shown)
LOGIN_OTP_TTL_MINUTES=10
LOGIN_OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
